# Agent settings read by ecu-agent.service (edit, then: systemctl --user restart ecu-agent)
ECU_ID=ECU-JETSON-1
ECU_BACKEND=100.95.205.56
ECU_HW=ORIN-NANO
ECU_FW=1.1.0
ECU_PROFILE=city
# Extra flags, split on spaces. --source jetson = report the board's own sensors instead of the plant model.
ECU_EXTRA=--source jetson
