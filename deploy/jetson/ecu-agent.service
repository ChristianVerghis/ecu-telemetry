# User service for the ecu-telemetry agent on a Jetson (installed by deploy/jetson/install.sh)
[Unit]
Description=ecu-telemetry agent (ECU-JETSON-1) streaming to the Mac backend over Tailscale
After=network-online.target tailscaled.service

[Service]
WorkingDirectory=%h/ecu-telemetry
EnvironmentFile=-%h/ecu-telemetry/agent.env
ExecStart=%h/ecu-telemetry/firmware/build/ecu_agent --id ${ECU_ID} --host ${ECU_BACKEND} --hw ${ECU_HW} --fw ${ECU_FW} --profile ${ECU_PROFILE}
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
